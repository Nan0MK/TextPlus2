<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!--
    UpgradeCode stays fixed so a newer MSI replaces this install.
    Windows Installer ignores a fourth version field, so the build number
    carries the patch: 26_1.0.0 is 26.1.0 and 26_1.0.1 is 26.1.1.
  -->
  <Package
    Name="TextPlus2"
    Manufacturer="Nan0MK"
    Version="$(var.MsiVersion)"
    UpgradeCode="97472D53-11D1-46EA-B18B-402CCD3EE02C"
    Scope="perMachine"
    Language="1033">

    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of TextPlus2 is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Advertised shortcuts require the icon id to end in .exe. The source file is still the logo. -->
    <Icon Id="TextPlus2.exe" SourceFile="..\resources\TextPlus2Logo.ico" />
    <Property Id="ARPPRODUCTICON" Value="TextPlus2.exe" />

    <!--
      Public and secure so the checkbox survives the jump to the elevated install.
      An unchecked box clears the property. The Install button writes 0 before the
      dialog closes, because a missing property would come back as this default.
      OPENWITH=0 on a silent install skips the registration. The default app is untouched.
    -->
    <Property Id="OPENWITH" Value="1" Secure="yes" />

    <!--
      Secure so the chosen folder reaches the elevated install. No Value here:
      an empty property would replace the Program Files default.
      A command-line INSTALLFOLDER is already set before SetDirectory, so it wins.
      The registry value is written by RememberFolder and read back on the next install.
    -->
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="REMEMBEREDFOLDER" Secure="yes">
      <RegistrySearch
        Id="RememberedFolderSearch"
        Root="HKLM"
        Key="Software\Nan0MK\TextPlus2"
        Name="InstallFolder"
        Type="directory"
        Bitness="always64" />
    </Property>
    <!--
      Before CostFinalize the directory property is still empty unless the
      command line set it. CostFinalize then fills the Program Files default,
      so a later set would see that default and skip the remembered folder.
    -->
    <SetProperty Id="INSTALLFOLDER" Value="[REMEMBEREDFOLDER]" Before="CostFinalize" Sequence="both" Condition="REMEMBEREDFOLDER AND NOT INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TextPlus2">
        <Component Id="AppExe" Guid="*">
          <File Id="AppExeFile" Source="$(var.ExePath)" KeyPath="yes" />
          <Shortcut
            Id="TextPlus2Start"
            Directory="ProgramMenuFolder"
            Name="TextPlus2"
            Description="TextPlus2"
            WorkingDirectory="INSTALLFOLDER"
            Icon="TextPlus2.exe"
            Advertise="yes" />
        </Component>
        <!--
          The upgrade removes the previous product before copying new files.
          Permanent keeps this file through that removal. NeverOverwrite leaves
          a copy the user has already changed. Users can write it. Administrators
          and SYSTEM keep full control because these entries replace the file ACL.
        -->
        <Component Id="Settings" Guid="6F2C8A41-9B17-4E5D-A3C8-1D04E7B59A26" Permanent="yes" NeverOverwrite="yes">
          <File Id="SettingsToml" Source="$(var.ConfigPath)" KeyPath="yes" Name="TextPlus2.toml">
            <util:PermissionEx User="Administrators" GenericAll="yes" />
            <util:PermissionEx User="SYSTEM" GenericAll="yes" />
            <util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" />
          </File>
        </Component>
        <!-- Stable guid so an upgrade replaces this registration instead of orphaning it. -->
        <Component Id="OpenWith" Guid="B7E2C4A1-9D58-4F63-8C20-6A1E5D93F047" Bitness="always64" Condition="OPENWITH = 1">
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\TextPlus2">
            <RegistryValue Type="string" Value="TextPlus2 Document" KeyPath="yes" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\TextPlus2\DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]TextPlus2.exe,0" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\TextPlus2\shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]TextPlus2.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\Applications\TextPlus2.exe">
            <RegistryValue Name="FriendlyAppName" Type="string" Value="TextPlus2" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\Applications\TextPlus2.exe\shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]TextPlus2.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\Applications\TextPlus2.exe\SupportedTypes">
            <RegistryValue Name=".txt" Type="string" Value="" />
            <RegistryValue Name=".md" Type="string" Value="" />
            <RegistryValue Name=".log" Type="string" Value="" />
            <RegistryValue Name=".json" Type="string" Value="" />
            <RegistryValue Name=".xml" Type="string" Value="" />
            <RegistryValue Name=".csv" Type="string" Value="" />
            <RegistryValue Name=".ini" Type="string" Value="" />
            <RegistryValue Name=".yml" Type="string" Value="" />
            <RegistryValue Name=".yaml" Type="string" Value="" />
            <RegistryValue Name=".toml" Type="string" Value="" />
            <RegistryValue Name=".cs" Type="string" Value="" />
            <RegistryValue Name=".odin" Type="string" Value="" />
            <RegistryValue Name=".ps1" Type="string" Value="" />
            <RegistryValue Name=".py" Type="string" Value="" />
            <RegistryValue Name=".js" Type="string" Value="" />
            <RegistryValue Name=".ts" Type="string" Value="" />
            <RegistryValue Name=".html" Type="string" Value="" />
            <RegistryValue Name=".css" Type="string" Value="" />
            <RegistryValue Name=".c" Type="string" Value="" />
            <RegistryValue Name=".h" Type="string" Value="" />
            <RegistryValue Name=".cpp" Type="string" Value="" />
            <RegistryValue Name=".hpp" Type="string" Value="" />
            <RegistryValue Name=".rs" Type="string" Value="" />
            <RegistryValue Name=".go" Type="string" Value="" />
            <RegistryValue Name=".java" Type="string" Value="" />
            <RegistryValue Name=".sql" Type="string" Value="" />
            <RegistryValue Name=".sh" Type="string" Value="" />
            <RegistryValue Name=".bat" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\SystemFileAssociations\text\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.txt\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.md\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.log\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.json\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.xml\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.csv\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.ini\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.yml\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.yaml\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.toml\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.cs\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.odin\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.ps1\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.py\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.js\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.ts\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.html\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.css\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.c\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.h\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.cpp\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.hpp\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.rs\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.go\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.java\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.sql\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.sh\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\.bat\OpenWithProgids">
            <RegistryValue Name="TextPlus2" Type="string" Value="" />
          </RegistryKey>
        </Component>
        <!-- Not permanent: uninstall removes the remembered folder. AppSearch runs before the old product is removed, so an upgrade still finds it. -->
        <Component Id="RememberFolder" Guid="C3A91E74-2B58-4D6F-8E10-9A4F6C2D7B15" Bitness="always64">
          <RegistryKey Root="HKLM" Key="Software\Nan0MK\TextPlus2">
            <RegistryValue Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
          </RegistryKey>
        </Component>
      </Directory>
    </StandardDirectory>

    <UI>
      <TextStyle Id="Tahoma8" FaceName="Tahoma" Size="8" />
      <Property Id="DefaultUIFont" Value="Tahoma8" />
      <Property Id="ErrorDialog" Value="ErrorDlg" />
      <Binary Id="ErrorIcon" SourceFile="..\resources\TextPlus2Logo.ico" />

      <Dialog Id="FolderDlg" Width="370" Height="270" Title="TextPlus2 Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="16" Transparent="yes" NoPrefix="yes" Text="Choose the install location" />
        <Control Id="Description" Type="Text" X="20" Y="48" Width="330" Height="40" Transparent="yes" NoPrefix="yes" Text="TextPlus2 installs for all users. The folder below is the default. Change it if you want TextPlus2 somewhere else." />
        <Control Id="FolderLabel" Type="Text" X="20" Y="100" Width="330" Height="12" Transparent="yes" NoPrefix="yes" Text="Install folder:" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="118" Width="250" Height="18" Property="INSTALLFOLDER" />
        <Control Id="Browse" Type="PushButton" X="278" Y="117" Width="72" Height="17" Text="Browse...">
          <Publish Property="_BrowseProperty" Value="INSTALLFOLDER" Order="1" />
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
          <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="1" />
          <Publish Event="NewDialog" Value="OpenWithDlg" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="BrowseDlg" Width="370" Height="270" Title="TextPlus2 Setup">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="16" Transparent="yes" NoPrefix="yes" Text="Change the destination folder" />
        <Control Id="Description" Type="Text" X="20" Y="36" Width="330" Height="16" Transparent="yes" NoPrefix="yes" Text="Select the folder where TextPlus2 will be installed." />
        <Control Id="ComboLabel" Type="Text" X="20" Y="60" Width="50" Height="10" TabSkip="no" Text="Look in:" />
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="70" Y="56" Width="220" Height="80" Property="_BrowseProperty" Indirect="yes" Fixed="yes" Remote="yes" />
        <Control Id="Up" Type="PushButton" X="298" Y="55" Width="52" Height="17" Text="Up">
          <Publish Event="DirectoryListUp" Value="0" />
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="20" Y="80" Width="330" Height="100" Property="_BrowseProperty" Sunken="yes" Indirect="yes" />
        <Control Id="PathLabel" Type="Text" X="20" Y="186" Width="330" Height="12" TabSkip="no" Text="Folder:" />
        <Control Id="PathEdit" Type="PathEdit" X="20" Y="200" Width="330" Height="18" Property="_BrowseProperty" Indirect="yes" />
        <Control Id="OK" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="OK">
          <Publish Event="SetTargetPath" Value="[_BrowseProperty]" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="Reset" Value="0" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
      </Dialog>

      <Dialog Id="OpenWithDlg" Width="370" Height="270" Title="TextPlus2 Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="16" Transparent="yes" NoPrefix="yes" Text="TextPlus2" />
        <Control Id="Description" Type="Text" X="20" Y="48" Width="330" Height="48" Transparent="yes" NoPrefix="yes" Text="TextPlus2 can appear in the Open with menu for text files. The default app for those files stays the same." />
        <Control Id="OpenWithCheck" Type="CheckBox" X="20" Y="110" Width="330" Height="18" Property="OPENWITH" CheckBoxValue="1" Text="Show TextPlus2 in Open with" />
        <Control Id="Back" Type="PushButton" X="168" Y="243" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="FolderDlg" />
        </Control>
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Install" ElevationShield="yes">
          <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="1" />
          <Publish Property="OPENWITH" Value="1" Condition="OPENWITH" Order="2" />
          <Publish Property="OPENWITH" Value="0" Condition="NOT OPENWITH" Order="3" />
          <Publish Event="EndDialog" Value="Return" Order="4" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="ProgressDlg" Width="370" Height="270" Title="TextPlus2 Setup" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="16" Transparent="yes" NoPrefix="yes" Text="Installing TextPlus2" />
        <Control Id="ActionText" Type="Text" X="20" Y="70" Width="330" Height="36">
          <Subscribe Event="ActionText" Attribute="Text" />
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="120" Width="330" Height="12" ProgressBlocks="yes">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="ErrorDlg" Width="270" Height="105" Title="TextPlus2 Setup" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="48" Y="15" Width="205" Height="60" TabSkip="no" NoPrefix="yes" Text="Information text" />
        <Control Id="ErrorIcon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="Information icon" FixedSize="yes" IconSize="32" Text="ErrorIcon" />
        <Control Id="Y" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="&amp;Yes">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
        <Control Id="A" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="&amp;Abort">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="C" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="&amp;Cancel">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="I" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="&amp;Ignore">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="N" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="&amp;No">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="O" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="OK">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="R" Type="PushButton" X="100" Y="80" Width="56" Height="17" TabSkip="yes" Text="&amp;Retry">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
      </Dialog>

      <Dialog Id="FilesInUse" Width="370" Height="270" Title="TextPlus2 Setup" KeepModeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="16" Transparent="yes" NoPrefix="yes" Text="Files in use" />
        <Control Id="Description" Type="Text" X="20" Y="40" Width="330" Height="32" Transparent="yes" NoPrefix="yes" Text="Some files that need to be updated are in use." />
        <Control Id="List" Type="ListBox" X="20" Y="80" Width="330" Height="130" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="Retry" Type="PushButton" X="164" Y="243" Width="56" Height="17" Text="&amp;Retry">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="230" Y="243" Width="56" Height="17" Text="&amp;Ignore">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Exit" Type="PushButton" X="296" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Exit">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="FatalError" Width="370" Height="270" Title="TextPlus2 Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="40" Transparent="yes" NoPrefix="yes" Text="TextPlus2 Setup Wizard ended prematurely" />
        <Control Id="Description" Type="Text" X="20" Y="70" Width="330" Height="60" Transparent="yes" NoPrefix="yes" Text="The wizard was interrupted before TextPlus2 could be installed. Your system has not been modified." />
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="UserExit" Width="370" Height="270" Title="TextPlus2 Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="40" Transparent="yes" NoPrefix="yes" Text="TextPlus2 Setup Wizard was interrupted" />
        <Control Id="Description" Type="Text" X="20" Y="70" Width="330" Height="40" Transparent="yes" NoPrefix="yes" Text="The wizard was interrupted. TextPlus2 has not been installed." />
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="ExitDialog" Width="370" Height="270" Title="TextPlus2 Setup">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="40" Transparent="yes" NoPrefix="yes" Text="TextPlus2 Setup is complete" />
        <Control Id="Description" Type="Text" X="20" Y="70" Width="330" Height="40" Transparent="yes" NoPrefix="yes" Text="TextPlus2 has been installed." />
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finish">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="FolderDlg" Before="ProgressDlg" Condition="NOT Installed" />
        <Show Dialog="ProgressDlg" Before="ExecuteAction" />
        <Show Dialog="FatalError" OnExit="error" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="ExitDialog" OnExit="success" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="FatalError" OnExit="error" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="ExitDialog" OnExit="success" />
      </AdminUISequence>
    </UI>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="Settings" />
      <ComponentRef Id="OpenWith" />
      <ComponentRef Id="RememberFolder" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Publish)**">
        <Exclude Files="!(bindpath.Publish)**\*.pdb" />
        <Exclude Files="$(var.ExePath)" />
        <Exclude Files="$(var.ConfigPath)" />
      </Files>
    </ComponentGroup>
  </Package>
</Wix>
