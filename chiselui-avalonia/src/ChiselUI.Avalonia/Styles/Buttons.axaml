    <Style Selector="^.flat:pointerover /template/ Border#PART_Surface"><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="^.flat:pressed /template/ Border#PART_Surface"><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="^.orb"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="999"/><Setter Property="Background" Value="{DynamicResource ChAccentGelBrush}"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="^.orb /template/ Border#PART_Surface"><Setter Property="BoxShadow" Value="{DynamicResource ChGelShadow}"/></Style>
    <Style Selector="^.orb /template/ Border#PART_Gloss"><Setter Property="Margin" Value="3,1,3,0"/><Setter Property="CornerRadius" Value="999,999,40,40"/><Setter Property="Background" Value="{DynamicResource ChGelGlossBrush}"/><Setter Property="Opacity" Value="0.5"/></Style>
    <Style Selector="^.orb:pointerover"><Setter Property="Background" Value="{DynamicResource ChGelHoverBrush}"/></Style>
    <Style Selector="^.orb:pointerover /template/ Border#PART_Surface"><Setter Property="BoxShadow" Value="{DynamicResource ChGelHoverShadow}"/></Style>
    <Style Selector="^.orb:pressed"><Setter Property="Background" Value="{DynamicResource ChGelPressedBrush}"/></Style>
    <Style Selector="^.orb:pressed /template/ Border#PART_Surface"><Setter Property="BoxShadow" Value="{DynamicResource ChGelPressedShadow}"/></Style>
    <Style Selector="^.segment"><Setter Property="Background" Value="Transparent"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="22"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource ChTextSecondaryBrush}"/></Style>
    <Style Selector="^.segment /template/ Border#PART_Surface"><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="^.segment /template/ Grid#PART_GlossHost"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="^.segment:pointerover"><Setter Property="Background" Value="{DynamicResource ChHoverWashBrush}"/><Setter Property="Foreground" Value="{DynamicResource ChTextBrush}"/></Style>
    <Style Selector="^.segment:pointerover /template/ Border#PART_Surface"><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="^.segment:pressed /template/ Border#PART_Surface"><Setter Property="BoxShadow" Value="none"/></Style>
    <Style Selector="^:disabled"><Setter Property="Background" Value="{DynamicResource ChButtonDisabledBrush}"/><Setter Property="Foreground" Value="{DynamicResource ChTextDisabledBrush}"/></Style>
    <Style Selector="^:disabled /template/ Border#PART_Surface"><Setter Property="BoxShadow" Value="{DynamicResource ChButtonDisabledShadow}"/></Style>
    <Style Selector="^:disabled /template/ Border#PART_Gloss"><Setter Property="Opacity" Value="0.5"/></Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource ChTextDisabledBrush}"/></Style>
  </ControlTheme>


  <!-- Caption capsule buttons (GlassFrame / ChiselWindow). Separate theme: no chrome, white gel. -->
  <ControlTheme x:Key="ChCaptionButton" TargetType="Button">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="{DynamicResource ChCaptionBrush}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Surface" Background="{TemplateBinding Background}" BoxShadow="{DynamicResource ChCaptionSepShadow}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.first /template/ Border#PART_Surface"><Setter Property="BoxShadow" Value="{DynamicResource ChCaptionShadow}"/></Style>
    <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource ChCaptionHoverBrush}"/></Style>
    <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.85"/></Style>
    <Style Selector="^.close"><Setter Property="Width" Value="44"/><Setter Property="Background" Value="{DynamicResource ChCloseBrush}"/></Style>
    <Style Selector="^.close:pointerover"><Setter Property="Background" Value="{DynamicResource ChCloseHoverBrush}"/></Style>
    <Style Selector="^.close:pointerover /template/ Border#PART_Surface"><Setter Property="BoxShadow" Value="{DynamicResource ChCloseHoverShadow}"/></Style>
  </ControlTheme>

  <!-- Accent swatch (AccentPicker): 18px gel circle, selected = surface ring + dark ring -->
  <ControlTheme x:Key="ChSwatchButton" TargetType="Button">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Ellipse x:Name="PART_Ring" Margin="-4" Fill="{DynamicResource ChSurfaceFloatBrush}" Stroke="{DynamicResource SwatchRing}" StrokeThickness="1.2" IsVisible="False"/>
          <Border x:Name="PART_Dot" CornerRadius="999" Background="{DynamicResource SwatchBrush}" BoxShadow="inset 0 0 0 1 #40000000, 0 1 2 0 #59000000"/>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Dot"><Setter Property="BoxShadow" Value="inset 0 0 0 1 #40000000, 0 0 9 0 #66FFFFFF"/></Style>
    <Style Selector="^.selected /template/ Ellipse#PART_Ring"><Setter Property="IsVisible" Value="True"/></Style>
  </ControlTheme>
</Styles.Resources>
  <Style Selector="Button.swatch"><Setter Property="Theme" Value="{StaticResource ChSwatchButton}"/></Style>
</Styles>
